DEBUG=true
# 监听端口建议写在配置文件 dbtool.toml 的 [server] port 里（见 configs/dbtool.example.toml）；
# 这里的 LISTEN 仍然有效，且优先于配置文件，一般不需要设置。
# LISTEN=:8000
# 会话 / 令牌签名密钥；生产必须换成随机值（dbt-admin gen-secrets），之后不要再改
SECRET_KEY=hfusaf2m4ot#7)fkw#di2bu6(cv0@opwmafx5n#6=3d%x^hpl6
# 密码可以写成 ENC(密文)：dbt-admin encrypt-url 生成（用下面的 MIRAGE_SECRET_KEY，缺省 SECRET_KEY；换密钥要重新加密）
DATABASE_URL=mysql://dbtool_rt:password@127.0.0.1:3306/db_tool
# 密文加密密钥（建议单独设置，≥ 32 字符；一经使用不要再改，dbt-admin gen-secrets 会生成）
# MIRAGE_SECRET_KEY=
# MIRAGE_CIPHER_MODE=ECB
# MIRAGE_CIPHER_IV=1234567890abcdef

# 生产环境建议开启：库表权限校验、SQL 工单的检查与执行都必须使用 goInception，未配置则拒绝（不降级为词法解析/原生执行）
# REQUIRE_GOINCEPTION=true

# 本系统对外访问地址，用于审批通知里的工单链接
#
# 对外访问地址：SSO 登录回调、通知里的工单链接都用它。反向代理需透传 X-Forwarded-Proto。
# 需要在元数据库手工执行的建表脚本（deploy/sql，按编号顺序，可重复执行；install.sh --apply-sql 会全部执行）：
#   001 通知渠道  002 SQL 工单定时执行  011 goInception 配置  013 性能巡检  015 慢日志采集状态
#   017 性能工单  018 登录方式/登录安全  019 按钮级权限
# PUBLIC_URL=https://dba.example.com

# 界面默认语言（zh-CN / en），默认 zh-CN。只影响还没选过语言的访客；用户在顶栏切换后以自己的选择为准
# DEFAULT_LANG=zh-CN

# 允许批量上线的实例类型（逗号分隔），默认只有 mssql
# BATCH_DB_TYPES=mssql

# 数据导出文件的基准目录：sql_config.local_path（默认 downloads/DataExportFile/）为相对路径时相对于它。
# 默认当前目录。
# EXPORT_BASE_DIR=/opt/dbtool

# goInception 配置文件（config.toml）的绝对路径：平台设置 › 审核引擎页读写它。
# dbtool 的运行用户需要对该文件所在“目录”有写权限（原子替换）。页面重启只支持 `docker restart <容器名>`：容器名在页面
# “部署与重启”里填写（不填则只能“仅保存”）；勾选 sudo 时请用 sudoers 白名单只放行这一条命令。dbtool 自己跑在没有 docker 命令的容器里时页面重启不可用。
# GOINCEPTION_CONFIG_FILE=/opt/dbtool/goinception/config.toml   # install.sh 安装时自动写入并部署这份初始配置

# 慢日志采集（Go 版）：默认开启，采哪些实例由“实例管理”里每个实例的“慢日志采集”开关决定（只读 mysql.slow_log）；设成 0 才整体关闭。
# SLOWLOG_COLLECT_ENABLE=0
# SLOW_COLLECT_INTERVAL=60              慢日志采集间隔（秒，5–3600）
# SLOW_COLLECT_WORKERS=2                采集并发（1–8）
# SLOWLOG_COLLECT_BACKFILL_DAYS=7       首次采集回溯天数（0–365）

# 其余功能开关不在环境变量里，而在“系统管理 / 配置项”（sql_config 表）里：
#   perf_go_jobs=collect,sla,verify,report   性能工单的后台任务（默认全关）
#   partman_auto_run=true                    分区维护自动执行（默认关）；partman_auto_drop、partman_auto_interval
#   soar / sqladvisor / soar_test_dsn / soar_config   SQL 优化外部工具的路径（未配置则相应功能提示未配置）
# 详见 docs/deployment.md
